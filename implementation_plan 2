### 2.2 Full SQL — CREATE TABLE Statements

```sql
-- ══════════════════════════════════════
-- CORE IDENTITY
-- ══════════════════════════════════════

CREATE TABLE profiles (
  id            UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
  role          TEXT NOT NULL DEFAULT 'employee'
                  CHECK (role IN ('super_admin','hr_admin','employee','task_manager_admin','auditor')),
  display_name  TEXT,
  avatar_url    TEXT,
  phone         TEXT,
  is_active     BOOLEAN NOT NULL DEFAULT TRUE,
  created_at    TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at    TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE system_audit_log (
  id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  actor_id      UUID REFERENCES auth.users(id),
  actor_role    TEXT,
  action        TEXT NOT NULL,
  target_type   TEXT,
  target_id     UUID,
  metadata      JSONB,
  ip_address    TEXT,
  created_at    TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ══════════════════════════════════════
-- HRM — ORGANISATION STRUCTURE
-- ══════════════════════════════════════

CREATE TABLE departments (
  id                UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  name              TEXT NOT NULL UNIQUE,
  description       TEXT,
  head_employee_id  UUID,
  is_active         BOOLEAN NOT NULL DEFAULT TRUE,
  created_at        TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE designations (
  id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  title         TEXT NOT NULL,
  department_id UUID REFERENCES departments(id) ON DELETE SET NULL,
  grade         TEXT,
  is_active     BOOLEAN NOT NULL DEFAULT TRUE
);

CREATE TABLE shifts (
  id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  name          TEXT NOT NULL,
  shift_code    TEXT UNIQUE,
  start_time    TIME NOT NULL,
  end_time      TIME NOT NULL,
  break_minutes INT NOT NULL DEFAULT 60,
  is_active     BOOLEAN NOT NULL DEFAULT TRUE
);

-- ══════════════════════════════════════
-- HRM — EMPLOYEES (MASTER)
-- ══════════════════════════════════════

CREATE TABLE employees (
  id                    UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  auth_user_id          UUID UNIQUE REFERENCES auth.users(id) ON DELETE SET NULL,
  employee_id           TEXT UNIQUE NOT NULL,
  name                  TEXT NOT NULL,
  username              TEXT UNIQUE NOT NULL,
  email                 TEXT UNIQUE NOT NULL,
  phone                 TEXT,
  date_of_birth         DATE,
  gender                TEXT CHECK (gender IN ('male','female','other','prefer_not_to_say')),
  blood_group           TEXT,

  -- Job
  department_id         UUID REFERENCES departments(id) ON DELETE SET NULL,
  designation_id        UUID REFERENCES designations(id) ON DELETE SET NULL,
  reporting_manager_id  UUID REFERENCES employees(id) ON DELETE SET NULL,
  employment_type       TEXT NOT NULL DEFAULT 'full_time'
                          CHECK (employment_type IN ('full_time','part_time','contractor','intern')),
  employee_status       TEXT NOT NULL DEFAULT 'active'
                          CHECK (employee_status IN ('active','on_leave','notice_period','terminated','resigned')),

  -- Dates
  date_of_joining       DATE NOT NULL,
  probation_end_date    DATE,
  last_working_day      DATE,
  notice_period_days    INT DEFAULT 30,

  -- Schedule
  shift_id              UUID REFERENCES shifts(id) ON DELETE SET NULL,
  working_days          TEXT[] DEFAULT ARRAY['Mon','Tue','Wed','Thu','Fri'],
  working_hours_start   TIME DEFAULT '10:00',
  working_hours_end     TIME DEFAULT '19:00',
  work_location         TEXT DEFAULT 'office'
                          CHECK (work_location IN ('office','remote','hybrid')),

  -- Compliance
  pan_number            TEXT,
  aadhar_number         TEXT,
  uan_number            TEXT,
  esi_number            TEXT,
  bank_account_number   TEXT,
  bank_ifsc             TEXT,
  bank_name             TEXT,

  -- Auth
  password_hash         TEXT,
  must_change_password  BOOLEAN DEFAULT TRUE,
  password_set_at       TIMESTAMPTZ,

  -- Profile
  profile_picture_url   TEXT,
  emergency_contact     JSONB,
  address               JSONB,

  -- Meta
  created_by            UUID REFERENCES employees(id) ON DELETE SET NULL,
  created_at            TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at            TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- FK back-reference for department head
ALTER TABLE departments
  ADD CONSTRAINT fk_dept_head
  FOREIGN KEY (head_employee_id)
  REFERENCES employees(id) ON DELETE SET NULL;

-- ══════════════════════════════════════
-- MODULE ACCESS (Central Permission Table)
-- ══════════════════════════════════════

CREATE TABLE module_access (
  id                UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  employee_id       UUID NOT NULL UNIQUE REFERENCES employees(id) ON DELETE CASCADE,
  task_manager      BOOLEAN NOT NULL DEFAULT FALSE,
  task_manager_role TEXT CHECK (task_manager_role IN ('admin','member','viewer')),
  auditing          BOOLEAN NOT NULL DEFAULT FALSE,
  auditing_role     TEXT CHECK (auditing_role IN ('lead','auditor','reviewer')),
  crm               BOOLEAN NOT NULL DEFAULT FALSE,
  crm_role          TEXT CHECK (crm_role IN ('admin','member')),
  hrm_admin         BOOLEAN NOT NULL DEFAULT FALSE,
  granted_by        UUID REFERENCES employees(id) ON DELETE SET NULL,
  granted_at        TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at        TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ══════════════════════════════════════
-- HRM — ATTENDANCE
-- ══════════════════════════════════════

CREATE TABLE attendance (
  id                      UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  employee_id             UUID NOT NULL REFERENCES employees(id) ON DELETE CASCADE,
  date                    DATE NOT NULL,
  shift_id                UUID REFERENCES shifts(id),
  check_in                TIMESTAMPTZ,
  check_out               TIMESTAMPTZ,
  actual_work_minutes     INT DEFAULT 0,
  status                  TEXT NOT NULL DEFAULT 'absent'
                            CHECK (status IN ('present','absent','late','half_day','on_leave','holiday','weekend')),
  late_in_minutes         INT DEFAULT 0,
  early_out_minutes       INT DEFAULT 0,
  source                  TEXT DEFAULT 'manual'
                            CHECK (source IN ('web_checkin','manual','biometric','regularized')),
  regularization_status   TEXT CHECK (regularization_status IN ('pending','approved','rejected')),
